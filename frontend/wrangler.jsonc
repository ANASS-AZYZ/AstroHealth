      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "ASTROHEALTH_DB",
          "database_name": "astrohealth-sessions-preview",
          "database_id": "016b60e3-4cba-4142-bfb3-493c1b6376d1",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
