{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/api.test.js tests/frontend-workflows.test.js",
    "test:cloudflare": "npm run cf:build && node --test tests/cloudflare.test.js",
    "test:browser": "playwright test",
    "test:charts": "playwright test --config playwright.charts.config.js",
    "reference:fixtures": "python scripts/reference-fixtures.py",
    "cf:build": "wrangler pages functions build --outdir .wrangler/build",
    "cf:dev": "wrangler pages dev dist",
    "cf:migrate:local": "wrangler d1 migrations apply astrohealth-sessions --local"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "axios": "^1.21.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "miniflare": "^5.20261113.0-beta",
    "vite": "^8.3.6",
    "wrangler": "^4.162.0"
  }
}
